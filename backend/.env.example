# ============================================================
# LexiCore Backend - Environment Variables
# Copy file này thành .env và điền giá trị thực
# KHÔNG commit file .env lên GitHub
# ============================================================

# Server
PORT=5000
NODE_ENV=production

# Client URL (Vercel frontend domain - dùng để CORS và redirect sau payment)
CLIENT_URL=https://lexicore.site

# --- Databases ---
MONGODB_URI=
MYSQL_URI=
REDIS_URL=

# --- Auth ---
JWT_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=

# --- AI ---
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- File Upload (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- SePay (Payment Gateway) ---
# Lấy từ Dashboard SePay > Cài đặt tích hợp API
SEPAY_API_KEY=
SEPAY_BANK_CODE=
SEPAY_ACC_NUMBER=
SEPAY_ACC_NAME=

