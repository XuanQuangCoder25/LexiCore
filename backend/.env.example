# Cấu hình Server
PORT=5000
# Dùng "development" khi chạy tại máy cá nhân, dùng "production" khi triển khai lên server
NODE_ENV=development

# Địa chỉ Client (Frontend)
CLIENT_URL=http://localhost:5173

# Cơ sở dữ liệu
MONGODB_URI=mongodb://localhost:27017/LexiCoreDB
MYSQL_URI=mysql://root:password@localhost:3306/lexicore
REDIS_URL=redis://localhost:6379

# Xác thực và Bảo mật (Auth)
JWT_SECRET=your_super_secret_jwt_key_here
REFRESH_TOKEN_SECRET=

# Dịch vụ gửi Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=LexiCore <onboarding@resend.dev>

# Dịch vụ Trí tuệ nhân tạo (AI)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Dịch vụ Lưu trữ tệp tin (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cổng thanh toán SePay (VietQR)
SEPAY_API_KEY=
SEPAY_BANK_CODE=BIDV
SEPAY_ACC_NUMBER=
SEPAY_ACC_NAME=

# Cơ chế giữ server hoạt động (Deploy Render)
BACKEND_PING_URL=
